# قبائل — Environment Variables

# Database (set by docker-compose, override for production)
DATABASE_URL=postgresql://user:password@localhost:5432/kabail_db?schema=public

# NextAuth
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=generate-a-secure-secret-at-least-32-characters-long

# Public host suffix (set by Base44 platform)
BASE44_PUBLIC_HOST_SUFFIX=preview.example

# Storage (future: S3 configuration)
# STORAGE_PROVIDER=local
# S3_ENDPOINT=
# S3_BUCKET=
# S3_ACCESS_KEY=
# S3_SECRET_KEY=

# AI Providers (future)
# OPENAI_API_KEY=
# GEMINI_API_KEY=
# ANTHROPIC_API_KEY=
