# ملف مثال — لا تضع أسرارًا حقيقية هنا
# انسخ الملف إلى .env ثم عدّل BETTER_AUTH_URL لعنوان بيئتك.
# في Codespaces، يضبط scripts/setup-codespaces.mjs العنوان تلقائيًا عند إنشاء .env.
DATABASE_URL="file:./dev.db"
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3000"
BETTER_AUTH_TRUSTED_ORIGINS=""
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
MAIL_FROM="مجالس العرب <no-reply@example.com>"

CATALOGUE_CURATOR_EMAILS=""

OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4.1-mini"

GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
